              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/employee_dataset/query?sortBy=age&order=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "employee_dataset",
                "query"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "age"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "Sort by age descending",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
