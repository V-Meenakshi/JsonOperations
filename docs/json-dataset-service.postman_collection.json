{
  "info": {
    "name": "JSON Dataset Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the three Insert requests first (in order), then the queries."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Insert",
      "item": [
        {
          "name": "Insert John Doe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"John Doe\",\n  \"age\": 30,\n  \"department\": \"Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dataset/employee_dataset/record",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "employee_dataset",
                "record"
              ]
            }
          }
        },
        {
          "name": "Insert Jane Smith",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 2,\n  \"name\": \"Jane Smith\",\n  \"age\": 25,\n  \"department\": \"Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dataset/employee_dataset/record",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "employee_dataset",
                "record"
              ]
            }
          }
        },
        {
          "name": "Insert Alice Brown",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 3,\n  \"name\": \"Alice Brown\",\n  \"age\": 28,\n  \"department\": \"Marketing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dataset/employee_dataset/record",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "employee_dataset",
                "record"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Query",
      "item": [
        {
          "name": "Group by department",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/employee_dataset/query?groupBy=department",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "employee_dataset",
                "query"
              ],
              "query": [
                {
                  "key": "groupBy",
                  "value": "department"
                }
              ]
            }
          }
        },
        {
          "name": "Sort by age ascending",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
