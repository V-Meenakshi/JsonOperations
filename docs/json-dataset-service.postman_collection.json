              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/employee_dataset/query?sortBy=age&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "employee_dataset",
                "query"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "age"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Group by department + sort by age",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/employee_dataset/query?groupBy=department&sortBy=age&order=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "employee_dataset",
                "query"
              ],
              "query": [
                {
                  "key": "groupBy",
                  "value": "department"
                },
                {
                  "key": "sortBy",
                  "value": "age"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "No operators (all records)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/employee_dataset/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "employee_dataset",
                "query"
              ]
            }
          }
        }
      ]
    },
